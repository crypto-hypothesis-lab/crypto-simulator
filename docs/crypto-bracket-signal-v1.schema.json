{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-hypothesis-lab.github.io/crypto-simulator/schemas/crypto-bracket-signal-v1.schema.json",
  "title": "Crypto bracket signal v1",
  "description": "Read-only public-to-private investment decision snapshot. It is not an order instruction until the private risk gate accepts it.",
  "type": "object",
  "required": [
    "schema_version",
    "event_type",
    "generated_at",
    "idempotency_key",
    "source",
    "decision",
    "recommended_action",
    "regime",
    "ranking",
    "candidates",
    "no_trade_reason",
    "guardrails",
    "strategy"
  ],
  "properties": {
    "schema_version": { "const": "crypto.bracket-signal.v1" },
    "event_type": { "const": "crypto_investment_decision" },
    "generated_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["exchange", "market", "interval", "closed_bar_timestamp", "benchmark_symbol", "symbols"],
      "properties": {
        "exchange": { "type": "array", "items": { "type": "string" } },
        "market": { "enum": ["spot", "margin", "perpetual"] },
        "interval": { "type": "string", "minLength": 1 },
        "closed_bar_timestamp": { "type": "string", "format": "date-time" },
        "benchmark_symbol": { "type": "string", "minLength": 1 },
        "symbols": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": true
    },
    "decision": { "enum": ["actionable", "no_trade"] },
    "recommended_action": { "enum": ["wait", "buy", "short", "mixed"] },
    "regime": {
      "type": "object",
      "required": ["label", "breadth", "confidence", "new_long_allowed", "new_short_allowed"],
      "properties": {
        "label": { "enum": ["risk_on", "risk_off", "neutral", "warmup"] },
        "breadth": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "new_long_allowed": { "type": "boolean" },
        "new_short_allowed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "symbol", "score", "eligible_long", "eligible_short"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "eligible_long": { "type": "boolean" },
          "eligible_short": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_id",
          "idempotency_key",
          "symbol",
          "direction",
          "confidence",
          "theme_score",
          "order",
          "stop_loss",
          "take_profit",
          "expires_at",
          "max_holding_days",
          "risk",
          "evidence"
        ],
        "properties": {
          "signal_id": { "type": "string", "minLength": 1 },
          "idempotency_key": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["long", "short"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "theme_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "order": {
            "type": "object",
            "required": ["side", "type", "price", "reduce_only", "price_is_planned_limit"],
            "properties": {
              "side": { "enum": ["buy", "sell"] },
              "type": { "const": "limit" },
              "price": { "type": "string", "minLength": 1 },
              "reduce_only": { "const": false },
              "price_is_planned_limit": { "const": true }
            },
            "additionalProperties": true
          },
          "stop_loss": {
            "type": "object",
            "required": ["type", "trigger_price", "reduce_only"],
            "properties": {
              "type": { "const": "stop_market_protective" },
              "trigger_price": { "type": "string", "minLength": 1 },
              "reduce_only": { "const": true }
            },
            "additionalProperties": true
          },
          "take_profit": {
            "type": "object",
            "required": ["type", "trigger_price", "price", "reduce_only"],
            "properties": {
              "type": { "const": "limit" },
              "trigger_price": { "type": "string", "minLength": 1 },
              "price": { "type": "string", "minLength": 1 },
              "reduce_only": { "const": true }
            },
            "additionalProperties": true
          },
          "expires_at": { "type": "string", "format": "date-time" },
          "max_holding_days": { "type": "integer", "minimum": 1, "maximum": 30 },
          "max_holding_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 720 },
          "risk": {
            "type": "object",
            "required": ["risk_per_trade", "sizing", "max_gross_leverage", "symbol_leverage_cap", "requires_current_equity_and_positions"],
            "properties": {
              "risk_per_trade": { "type": "number", "exclusiveMinimum": 0 },
              "sizing": { "const": "risk_based_after_fill" },
              "max_gross_leverage": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
              "symbol_leverage_cap": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
              "requires_current_equity_and_positions": { "const": true }
            },
            "additionalProperties": true
          },
          "evidence": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "no_trade_reason": { "type": ["string", "null"] },
    "guardrails": {
      "type": "object",
      "required": [
        "market_order_fallback",
        "cancel_on_regime_flip",
        "limit_expiry_bars",
        "max_holding_days",
        "stop_target_same_bar_policy",
        "strategy_status"
      ],
      "properties": {
        "market_order_fallback": { "const": false },
        "cancel_on_regime_flip": { "type": "boolean" },
        "limit_expiry_bars": { "type": "integer", "minimum": 1 },
        "max_holding_days": { "type": "integer", "minimum": 1, "maximum": 30 },
        "max_holding_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 720 },
        "stop_target_same_bar_policy": { "const": "stop_first" },
        "strategy_status": { "const": "research_candidate_only" }
      },
      "additionalProperties": true
    },
    "strategy": { "type": "object" }
  },
  "additionalProperties": true
}
